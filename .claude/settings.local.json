{
  "permissions": {
    "allow": [
      "Bash(git branch *)",
      "Bash(git init *)",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3000)",
      "PowerShell(try { $r = Invoke-WebRequest -Uri \"http://localhost:3000\" -TimeoutSec 10 -UseBasicParsing; \"Status: $\\($r.StatusCode\\)\" } catch { \"Error: $_\" })",
      "PowerShell(try { $r = Invoke-WebRequest -Uri \"http://localhost:3000/api/projects\" -TimeoutSec 10 -UseBasicParsing; \"Status: $\\($r.StatusCode\\) | Body: $\\($r.Content\\)\" } catch { \"Error: $_\" })",
      "PowerShell($body = '{\"name\":\"Test Project\"}'; $r = Invoke-WebRequest -Uri \"http://localhost:3000/api/projects\" -Method POST -Body $body -ContentType \"application/json\" -UseBasicParsing -TimeoutSec 10; \"Status: $\\($r.StatusCode\\) | $\\($r.Content\\)\")",
      "PowerShell(try { $r = Invoke-WebRequest -Uri \"http://localhost:3000/projects/1\" -TimeoutSec 15 -UseBasicParsing; \"Status: $\\($r.StatusCode\\), Content length: $\\($r.Content.Length\\)\" } catch { \"Error: $_\" })",
      "PowerShell(Start-Sleep -Seconds 3; try { $r = Invoke-WebRequest -Uri \"http://localhost:3000/projects/1\" -TimeoutSec 15 -UseBasicParsing; \"Status: $\\($r.StatusCode\\), Length: $\\($r.Content.Length\\)\" } catch { \"Error: $_\" })",
      "Bash(node -e \"const r=require\\('./node_modules/react/package.json'\\);console.log\\('react:',r.version\\)\")",
      "Bash(node -e \"const r=require\\('./node_modules/next/package.json'\\);console.log\\('next:',r.version\\)\")",
      "Bash(npx tsc *)",
      "PowerShell(try { $r = Invoke-WebRequest -Uri \"http://localhost:3000\" -TimeoutSec 10 -UseBasicParsing; \"Status: $\\($r.StatusCode\\)\" } catch { \"Server not responding — needs restart\" })",
      "PowerShell(Start-Sleep 2; try { $r = Invoke-WebRequest -Uri \"http://localhost:3000\" -TimeoutSec 10 -UseBasicParsing; \"Status: $\\($r.StatusCode\\)\" } catch { \"Error: $_\" })"
    ]
  }
}
